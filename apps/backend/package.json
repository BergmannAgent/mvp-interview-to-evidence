{
  "name": "@orgscience/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. apps/backend/src",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.0",
    "@mastra/core": "1.58.0",
    "@mastra/hono": "1.6.0",
    "@mastra/observability": "1.16.6",
    "@mastra/pg": "1.20.0",
    "@mastra/server": "1.58.0",
    "@orgscience/contracts": "0.1.0",
    "@orgscience/domain": "0.1.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "hono": "4.13.1",
    "pg": "8.22.0",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.4",
    "@types/yauzl": "2.10.3",
    "jszip": "3.10.1"
  }
}
