# Enable only for deterministic provider-free development; Voice never falls back to demo mode.
DEMO_MODE=false
NODE_ENV=development

DATABASE_URL=postgresql://interview:interview@postgres:5432/interview
DATABASE_READINESS_TIMEOUT_MS=2000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
BACKEND_SHUTDOWN_TIMEOUT_MS=5000
HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Optional absolute monitoring frontend origin; local defaults use the adjacent port.
VITE_MONITORING_ORIGIN=http://localhost:5174
REALTIME_POLL_INTERVAL_MS=1000
REALTIME_REPLAY_PAGE_SIZE=250
REALTIME_MAXIMUM_REPLAY_EVENTS=50000
REALTIME_MAXIMUM_SUBSCRIBERS=200
REALTIME_MAXIMUM_SUBSCRIBERS_PER_INTERVIEW=20
REALTIME_HEARTBEAT_INTERVAL_MS=15000
REALTIME_RETRY_MS=1000
REALTIME_WRITE_TIMEOUT_MS=5000
REALTIME_MAXIMUM_FRAME_BYTES=262144

# Required for Voice mode. Voice fails explicitly when this key is empty; there is no fallback.
OPENAI_API_KEY=
# Fast per-turn checks and question planning during the live interview.
INTERVIEW_AGENT_MODEL=openai/gpt-5.4-nano
# Stronger coding model, invoked only after the transcript is finalized.
EVALUATION_MODEL=openai/gpt-5.6-terra
# Post-interview coding is outside the live path; valid deadlines range from 1s to 4min.
EVALUATION_TIMEOUT_MS=120000
# Deprecated compatibility fallback when either role-specific variable is omitted.
AI_MODEL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_SECRET_TTL_SECONDS=600
