  "scenarioRoutes": [
    {
      "routeId": "actual_event",
      "evidenceClassification": "observed_event",
      "activationConditionDe": "Die interviewte Person kann eine tatsächlich erlebte Krise oder erhebliche Belastung beschreiben.",
      "interviewerInstructionDe": "Erfrage konkrete Abläufe, beobachtetes Verhalten, Verantwortlichkeiten, Zeitpunkte und Folgen neutral anhand des erlebten Ereignisses.",
      "scoringConstraintDe": "Nur wörtlich belegte Aussagen zum beobachteten Organisationsverhalten dürfen als tatsächliche Ereignisevidenz codiert werden."
    },
    {
      "routeId": "hypothetical_event",
      "evidenceClassification": "hypothetical_response",
      "activationConditionDe": "Die interviewte Person kann kein ausreichend passendes Ereignis schildern, kann aber einen hypothetischen Ablauf erläutern.",
      "interviewerInstructionDe": "Formuliere genau eine neutrale Was-wäre-wenn-Frage und kennzeichne die Antwort als hypothetische Aussage.",
      "scoringConstraintDe": "Hypothetische Absichten sind keine beobachtete Verhaltensleistung und dürfen nicht wie tatsächliche Krisenevidenz behandelt werden."
    },
    {
      "routeId": "no_crisis_experienced",
      "evidenceClassification": "preparation_or_minor_disruption",
      "activationConditionDe": "Die interviewte Person erklärt ausdrücklich, dass die Organisation keine Krise erlebt hat.",
      "interviewerInstructionDe": "Akzeptiere die Aussage ohne Widerspruch und frage neutral nach Übungen, kleineren Störungen oder konkreter Vorbereitung, soweit vorhanden.",
      "scoringConstraintDe": "Das Fehlen einer erlebten Krise ist keine niedrige Resilienzausprägung; fehlende beobachtbare Evidenz führt zu unzureichender Evidenz oder nicht anwendbar."
    }
  ],
